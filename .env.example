# Zap AI Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider API Keys (set at least one)
# =============================================================================

# Anthropic (for Claude models)
ANTHROPIC_API_KEY=

# OpenAI (for GPT models)
# OPENAI_API_KEY=

# Azure OpenAI
# AZURE_API_KEY=
# AZURE_API_BASE=https://your-resource.openai.azure.com/

# =============================================================================
# Zap Configuration (optional)
# =============================================================================

# Temporal server address (default: localhost:7233)
# TEMPORAL_ADDRESS=localhost:7233

# Task queue name (default: zap-agents)
# ZAP_TASK_QUEUE=zap-agents

